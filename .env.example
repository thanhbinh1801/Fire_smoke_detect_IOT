# ==============================================================================
# CẤU HÌNH HỆ THỐNG NHẬN DIỆN LỬA & KHÓI IOT (FIRE & SMOKE DETECTION)
# Sao chép file này thành .env và chỉnh sửa các thông số phù hợp với thiết bị:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NỀN TẢNG & CAMERA
# ------------------------------------------------------------------------------
# Nền tảng chạy: "laptop" (giả lập GPIO qua console) hoặc "pi" (Raspberry Pi GPIO thật)
PLATFORM=laptop

# Nguồn camera: "usb" (Webcam USB qua OpenCV) hoặc "csi" (Picamera2 IMX519 trên Pi)
CAMERA_SOURCE=usb

# Chỉ số webcam khi dùng USB (0 = /dev/video0 hoặc webcam mặc định)
WEBCAM_INDEX=0

# Định dạng nén ưu tiên cho webcam USB (MJPG giúp đạt 30 FPS ở 640x480 trên Pi)
WEBCAM_FOURCC=MJPG

# Độ phân giải khung hình thu nhận từ camera
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Tốc độ khung hình mục tiêu của camera và thời gian tối đa chờ frame mới (giây)
CAMERA_FPS=30
CAMERA_STALE_TIMEOUT=2.0

# Cấu hình chuyên sâu cho camera CSI (Arducam IMX519) & xử lý màu
CAMERA_AUTOFOCUS=false
CAMERA_LENS_POSITION=2.5
CAMERA_EXPOSURE_COMP=-0.5
CAMERA_SWAP_RB=false

# Tỷ lệ bỏ qua khung hình cho chế độ đồng bộ dự phòng
FRAME_SKIP=2

# ------------------------------------------------------------------------------
# 2. MODEL AI & SUY LUẬN (ONNX RUNTIME)
# ------------------------------------------------------------------------------
# Đường dẫn tới file model ONNX
MODEL_PATH=models/fire_smoke_yolov8n.onnx

# Ngưỡng độ tin cậy (Confidence Threshold) chung và riêng cho từng lớp (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.40
FIRE_CONFIDENCE_THRESHOLD=0.40
SMOKE_CONFIDENCE_THRESHOLD=0.38

# Ngưỡng IoU cho thuật toán Non-Maximum Suppression (NMS)
IOU_THRESHOLD=0.45

# Diện tích bounding box tối thiểu (pixel^2) để lọc bỏ nhiễu điểm ảnh li ti
MIN_BOX_AREA=36

# Số luồng CPU dành cho ONNX Runtime (trên Raspberry Pi 4 nên đặt 3 để chừa 1 nhân cho OS/Camera)
ORT_INTRA_THREADS=3

# ------------------------------------------------------------------------------
# 3. TIỀN XỬ LÝ ẢNH (PREPROCESSING)
# ------------------------------------------------------------------------------
# Tăng tương phản cục bộ CLAHE trên kênh L (LAB) giúp rõ khói mờ / ngược sáng
PREPROCESS_ENABLE_CLAHE=false
PREPROCESS_CLAHE_CLIP_LIMIT=2.0
PREPROCESS_CLAHE_GRID_SIZE=8

# Hiệu chỉnh sáng Gamma (1.0 = tắt; < 1.0 giảm chói sáng; > 1.0 làm sáng vùng tối)
PREPROCESS_GAMMA=1.0

# Khử nhiễu Gaussian trước khi đưa vào model (0 = tắt; 3 hoặc 5 = kích thước kernel lẻ)
PREPROCESS_DENOISE_KERNEL=0

# Cân bằng trắng tự động (Gray World) giúp ổn định màu lửa dưới ánh đèn màu
PREPROCESS_AUTO_WB=false

# Làm sắc nét biên đối tượng (Unsharp Mask)
PREPROCESS_SHARPEN=false

# Vùng quan tâm ROI theo tỷ lệ "x1,y1,x2,y2" trong khoảng 0.0-1.0 (để trống = toàn khung hình)
PREPROCESS_ROI=

# ------------------------------------------------------------------------------
# 4. XÁC NHẬN CẢNH BÁO & CHỐNG BÁO ĐỘNG GIẢ (CONFIRMATION & VOTING)
# ------------------------------------------------------------------------------
# Thời gian duy trì trạng thái cảnh báo lửa sau khi lửa vừa tắt (giây)
HOLD_FIRE_TIME=1.5

# Cửa sổ thời gian xác nhận LỬA cho còi & đèn LED
FIRE_CONFIRM_WINDOW_SECONDS=1.5
FIRE_CONFIRM_MIN_RATIO=0.6
FIRE_CONFIRM_MIN_SAMPLES=4
FIRE_CONFIRMATION_FRAMES=2

# Xác nhận KHÓI (số lần suy luận liên tiếp và cửa sổ thời gian)
SMOKE_CONFIRMATION_FRAMES=2
SMOKE_CONFIRM_WINDOW_SECONDS=2.0
SMOKE_CONFIRM_MIN_RATIO=0.5
SMOKE_CONFIRM_MIN_SAMPLES=2

# ------------------------------------------------------------------------------
# 5. ĐÈN LED & CÒI BÁO ĐỘNG (GPIO ALERT)
# ------------------------------------------------------------------------------
# Chân GPIO (BCM) cho đèn LED và còi Buzzer
LED_PIN=27
BUZZER_PIN=17

# Loại còi: "passive" (cần xung PWM) hoặc "active" (cấp HIGH tự kêu)
BUZZER_TYPE=passive
BUZZER_FREQUENCY=2000

# Thời gian kêu và giãn cách tối thiểu giữa 2 lần kích hoạt (giây)
ALERT_DURATION=2.0
ALERT_COOLDOWN=5.0

# ------------------------------------------------------------------------------
# 6. CƠ CẤU CHẤP HÀNH: SERVO PAN CAMERA & BƠM NƯỚC (ACTUATORS)
# ------------------------------------------------------------------------------
# Cấu hình Servo SG90
SERVO_PIN=18
SERVO_MIN_ANGLE=30.0
SERVO_MAX_ANGLE=150.0
SERVO_CENTER_ANGLE=90.0
SERVO_STEP_ANGLE=10.0
SERVO_MIN_PULSE_WIDTH=0.0005
SERVO_MAX_PULSE_WIDTH=0.0024
SERVO_SETTLE_SECONDS=0.6

# Cấu hình Relay Bơm nước R385
PUMP_PIN=23
PUMP_ACTIVE_HIGH=true
PUMP_CONFIDENCE_THRESHOLD=0.60
PUMP_CONFIRM_WINDOW_SECONDS=3.0
PUMP_CONFIRM_MIN_RATIO=0.7
PUMP_CONFIRM_MIN_SAMPLES=8
PUMP_MAX_SECONDS=5.0
PUMP_COOLDOWN=15.0
PUMP_MAX_PER_MINUTE=4

# Tự động tắt chế độ phun tự động (Auto-Arm) nếu không có tương tác web sau (giây)
ACTUATOR_WATCHDOG_SECONDS=600.0

# ------------------------------------------------------------------------------
# 7. THÔNG BÁO TELEGRAM BOT
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=true
# Điền Bot Token lấy từ @BotFather (ví dụ: 123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Điền Chat ID của người nhận hoặc nhóm (để trống và nhắn /start cho bot để tự nhận diện)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Thời gian giãn cách (cooldown - giây) giữa 2 lần gửi tin nhắn Telegram
TELEGRAM_FIRE_COOLDOWN=30.0
TELEGRAM_SMOKE_COOLDOWN=60.0
TELEGRAM_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# 8. HIỂN THỊ, LƯU SNAPSHOT & WEB SERVER
# ------------------------------------------------------------------------------
# Hiển thị cửa sổ OpenCV trực tiếp (main.py)
SHOW_DISPLAY=true
DISPLAY_FPS=15
WINDOW_NAME=Hệ thống nhận diện lửa - IoT

# Lưu ảnh chụp khi phát hiện cháy
SAVE_SNAPSHOT=false
SNAPSHOT_DIR=data/snapshots
SNAPSHOT_COOLDOWN=2.0

# Cấu hình Flask Web Dashboard (web_server.py)
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_STREAM_FPS=12
WEB_JPEG_QUALITY=80
